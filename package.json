{
  "name": "gazelle",
  "private": true,
  "description": "Gazelle by Alternative Bank \u2014 corporate credit origination, assessment, approval and monitoring platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @gazelle/api dev",
    "dev:web": "pnpm --filter @gazelle/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm -r test",
    "migrate": "pnpm --filter @gazelle/api migrate",
    "seed": "pnpm --filter @gazelle/api seed",
    "e2e": "pnpm --filter @gazelle/web e2e"
  },
  "pnpm": {
    "overrides": {
      "uuid": ">=11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
