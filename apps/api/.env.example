# Copy to .env for local development. NEVER commit .env. Production values come from the Bank's secrets manager.
APP_ENV=development
PORT=4000
DATABASE_URL=postgres://gazelle:CHANGE_ME@localhost:5432/gazelle_dev
WEB_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HMAC_KEY=
DATA_KEY=
DATA_KEY_ID=local-v1
STORAGE_DIR=./storage
COOKIE_SECURE=false
# Integration modes: mock | live. Production refuses to start with mock integrations.
CBA_MODE=mock
IDENTITY_MODE=mock
MESSAGING_MODE=mock
AD_MODE=mock
BUREAU_MODE=mock
RARORAC_MODE=mock
AV_MODE=mock
AI_MODE=local
